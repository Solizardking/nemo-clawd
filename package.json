{
  "name": "@mawdbotsonsolana/nemoclawd",
  "version": "0.5.0",
  "description": "nemoclawd - Solana-native agentic trading engine with DFlow spot/prediction routing, $CLAWD token support, MCP tools, and Telegram trading bot.",
  "license": "Apache-2.0",
  "keywords": [
    "dflow",
    "solana",
    "pump-fun",
    "trading-bot",
    "telegram-bot",
    "solana-developer-tools",
    "solana-agent",
    "pumpfun",
    "agentic-wallet",
    "privy",
    "nemoclawd",
    "openshell",
    "nvidia",
    "ai-agent",
    "defi",
    "autonomous-agent",
    "ollama",
    "deepsolana",
    "xai",
    "grok",
    "mcp",
    "solana-clawd",
    "memecoin",
    "solana-trading"
  ],
  "bin": {
    "nemoclawd": "bin/nemoclawd.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:plugin": "tsc",
    "build:mcp": "npm --prefix nemo-clawd-mcp run build",
    "build:zk": "pnpm --dir zk-primitives -r build",
    "lint:zk": "pnpm --dir zk-primitives -r lint",
    "test:zk": "pnpm --dir zk-primitives -r test",
    "check:zk": "npm run build:zk && npm run lint:zk && npm run test:zk",
    "services:install": "npm ci --prefix services/gateway && npm ci --prefix services/inference-mesh && npm ci --prefix services/clawdrouter",
    "services:gateway:build": "npm --prefix services/gateway run build",
    "services:gateway:test": "npm --prefix services/gateway test",
    "services:inference-mesh:build": "npm --prefix services/inference-mesh run build",
    "services:clawdrouter:build": "npm --prefix services/clawdrouter run build",
    "services:clawdrouter:test": "npm --prefix services/clawdrouter test",
    "services:operator:check": "PYTHONDONTWRITEBYTECODE=1 python3 -m py_compile $(find services/clawd-operator -name '*.py' -not -path '*/__pycache__/*')",
    "services:livekit:check": "PYTHONDONTWRITEBYTECODE=1 python3 -m py_compile services/livekit-agent/*.py",
    "services:build": "npm run services:gateway:build && npm run services:inference-mesh:build && npm run services:clawdrouter:build",
    "services:test": "npm run services:gateway:test && npm run services:clawdrouter:test && npm run services:operator:check && npm run services:livekit:check",
    "build": "npm run build:plugin && npm run build:mcp",
    "public:audit": "bash scripts/public-release-audit.sh",
    "pack:check": "npm pack --dry-run --cache /tmp/nemoclawd-npm-cache",
    "release:check": "npm run build && npm test && npm run public:audit && npm run pack:check",
    "publish:public": "npm publish --access public",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "tar": "^7.5.16"
  },
  "files": [
    "bin/",
    "SKILL.md",
    "dist/",
    "nemoclawd.plugin.json",
    "nemo-clawd-mcp/",
    "!nemo-clawd-mcp/node_modules/",
    "zk-primitives/",
    "!zk-primitives/node_modules/",
    "!zk-primitives/**/node_modules/",
    "!zk-primitives/**/dist/",
    "!zk-primitives/**/target/",
    "!zk-primitives/**/package-lock.json",
    "services/",
    "!services/**/node_modules/",
    "!services/**/dist/",
    "!services/**/.agent/",
    "!services/**/.surfpool/",
    "!services/**/.logs/",
    "!services/**/logs/",
    "!services/**/output/",
    "!services/**/.pytest_cache/",
    "!services/**/__pycache__/",
    "!services/**/.env",
    "!services/**/.env.local",
    "Pump-Fun/src/",
    "Pump-Fun/agent-app/",
    "Pump-Fun/agent-tasks/",
    "Pump-Fun/docs/",
    "Pump-Fun/packages/defi-agents/",
    "Pump-Fun/pumpkit/",
    "Pump-Fun/pumpkit/agent-prompts/",
    "Pump-Fun/pumpkit/tutorials/",
    "Pump-Fun/telegram-bot/",
    "Pump-Fun/swarm-bot/",
    "Pump-Fun/websocket-server/",
    "Pump-Fun/tools/",
    "Pump-Fun/x402/",
    "pump-fun-skills-main/tokenized-agents/",
    "scripts/brev-setup.sh",
    "scripts/fix-coredns.sh",
    "scripts/install-openshell.sh",
    "scripts/install.sh",
    "scripts/nemoclawd-payment-app.sh",
    "scripts/nemoclawd-solana-agent.sh",
    "scripts/nemoclawd-solana-bridge.sh",
    "scripts/nemoclawd-solana-stack.sh",
    "scripts/nemoclawd-start.sh",
    "scripts/nemoclawd-swarm-bot.sh",
    "scripts/nemoclawd-telegram-bot.sh",
    "scripts/nemoclawd-websocket-server.sh",
    "scripts/pre-commit-secrets.sh",
    "scripts/public-release-audit.sh",
    "scripts/setup-orin-nano.sh",
    "scripts/setup-spark.sh",
    "scripts/setup.sh",
    "scripts/start-services.sh",
    "scripts/test-inference-local.sh",
    "scripts/test-inference.sh",
    "scripts/walkthrough.sh",
    "scripts/write-auth-profile.py",
    "scripts/nemoclawd-agent-registry.sh",
    "scripts/telegram-bridge.js",
    "Dockerfile",
    ".dockerignore"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x402agent/nemo-clawd.git"
  },
  "homepage": "https://nemo.nanosolana.com",
  "bugs": {
    "url": "https://github.com/x402agent/nemo-clawd/issues"
  }
}
